{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "none",
    "moduleDetection": "legacy",
    "types": ["chrome"],
    "rootDir": "src",
    "outDir": "build",
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "newLine": "lf",
    "removeComments": false
  },
  "include": ["src/**/*.ts"]
}
